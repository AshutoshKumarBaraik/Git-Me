PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/gitMe
# Optional: force the database name (the user controller uses "gitMe")
# DB_NAME=gitMe
JWT_SECRET_KEY=change-me

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Chatbot (optional - without a key the bot answers in offline mode)
# Get a key at https://openrouter.ai/keys  (never commit the real key)
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models  (e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5, google/gemini-2.0-flash-001)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional legacy provider, only used if OPENROUTER_API_KEY is empty
ANTHROPIC_API_KEY=
